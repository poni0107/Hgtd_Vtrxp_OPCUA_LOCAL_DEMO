<?xml version="1.0" encoding="UTF-8"?>

<d:design
    projectShortName="HgtdVtrxpOpcUa"
    xmlns:d="http://cern.ch/quasar/Design"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://cern.ch/quasar/Design Design.xsd">

    <d:class name="VTRxp">

        <d:devicelogic></d:devicelogic>

        <!--
            Application diagnostics. Generated AS/Base files must be
            regenerated by QUASAR after this source design changes.
        -->
        <d:cachevariable
            initializeWith="valueAndStatus"
            dataType="OpcUa_UInt32"
            name="LastReadAddress"
            nullPolicy="nullAllowed"
            addressSpaceWrite="forbidden"
            initialStatus="OpcUa_BadWaitingForInitialData">
        </d:cachevariable>

        <d:cachevariable
            initializeWith="valueAndStatus"
            dataType="OpcUa_Byte"
            name="LastReadValue"
            nullPolicy="nullAllowed"
            addressSpaceWrite="forbidden"
            initialStatus="OpcUa_BadWaitingForInitialData">
        </d:cachevariable>

        <d:cachevariable
            initializeWith="valueAndStatus"
            dataType="UaString"
            name="LastOperationType"
            nullPolicy="nullAllowed"
            addressSpaceWrite="forbidden"
            initialStatus="OpcUa_BadWaitingForInitialData">
        </d:cachevariable>

        <d:cachevariable
            initializeWith="valueAndStatus"
            dataType="OpcUa_UInt32"
            name="LastOperationAddress"
            nullPolicy="nullAllowed"
            addressSpaceWrite="forbidden"
            initialStatus="OpcUa_BadWaitingForInitialData">
        </d:cachevariable>

        <d:cachevariable
            initializeWith="valueAndStatus"
            dataType="OpcUa_Byte"
            name="LastOperationValue"
            nullPolicy="nullAllowed"
            addressSpaceWrite="forbidden"
            initialStatus="OpcUa_BadWaitingForInitialData">
        </d:cachevariable>

        <d:cachevariable
            initializeWith="valueAndStatus"
            dataType="OpcUa_Boolean"
            name="LastOperationSuccess"
            nullPolicy="nullAllowed"
            addressSpaceWrite="forbidden"
            initialStatus="OpcUa_BadWaitingForInitialData">
        </d:cachevariable>

        <d:cachevariable
            initializeWith="valueAndStatus"
            dataType="UaString"
            name="LastOperationStatus"
            nullPolicy="nullAllowed"
            addressSpaceWrite="forbidden"
            initialStatus="OpcUa_BadWaitingForInitialData">
        </d:cachevariable>

        <d:cachevariable
            initializeWith="valueAndStatus"
            dataType="UaString"
            name="LastError"
            nullPolicy="nullAllowed"
            addressSpaceWrite="forbidden"
            initialStatus="OpcUa_BadWaitingForInitialData">
        </d:cachevariable>

        <d:cachevariable
            initializeWith="valueAndStatus"
            dataType="OpcUa_UInt64"
            name="Generation"
            nullPolicy="nullAllowed"
            addressSpaceWrite="forbidden"
            initialStatus="OpcUa_BadWaitingForInitialData">
        </d:cachevariable>

        <d:cachevariable
            initializeWith="valueAndStatus"
            dataType="UaString"
            name="CommunicationState"
            nullPolicy="nullAllowed"
            addressSpaceWrite="forbidden"
            initialStatus="OpcUa_BadWaitingForInitialData">
        </d:cachevariable>

        <d:method
            addressSpaceCallUseMutex="no"
            name="readRegister"
            executionSynchronicity="synchronous">
            <d:argument
                dataType="OpcUa_UInt32"
                name="regAdr">
            </d:argument>
        </d:method>

        <d:method
            addressSpaceCallUseMutex="no"
            name="writeRegister"
            executionSynchronicity="synchronous">
            <d:argument
                dataType="OpcUa_UInt32"
                name="regAdr">
            </d:argument>
            <d:argument
                dataType="OpcUa_Byte"
                name="regVal">
            </d:argument>
        </d:method>

        <d:configentry
            dataType="UaString"
            name="serialCommunicatorHost"
            storedInDeviceObject="true">
        </d:configentry>
        <d:configentry
            dataType="UaString"
            name="serialCommunicatorPort"
            storedInDeviceObject="true">
        </d:configentry>
        <d:configentry
            dataType="UaString"
            name="felixId"
            storedInDeviceObject="true">
        </d:configentry>
        <d:configentry
            dataType="UaString"
            name="lpGbtId"
            storedInDeviceObject="true">
        </d:configentry>
        <d:configentry
            dataType="UaString"
            name="i2cMasterId"
            storedInDeviceObject="true">
        </d:configentry>
        <d:configentry
            dataType="UaString"
            name="i2cSlaveId"
            storedInDeviceObject="true">
        </d:configentry>

    </d:class>

    <d:root>
        <d:hasobjects
            instantiateUsing="configuration"
            class="VTRxp">
        </d:hasobjects>
    </d:root>

</d:design>
